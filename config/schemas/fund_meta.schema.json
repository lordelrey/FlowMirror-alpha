{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowmirror.example/schemas/fund_meta.schema.json",
  "title": "FlowMirror fund metadata record",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^\\d{6}$"
    },
    "name": {
      "type": "string"
    },
    "org": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "r_level": {
      "type": "string",
      "enum": [
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ]
    },
    "family": {
      "type": "string"
    },
    "qdii": {
      "type": "boolean"
    },
    "aum_yi": {
      "type": "number"
    },
    "inception_years": {
      "type": "number"
    },
    "fee": {
      "type": "object",
      "properties": {
        "mgmt": {
          "type": "number"
        },
        "subscribe": {
          "type": "number"
        },
        "redeem": {
          "type": "number"
        }
      },
      "required": [
        "mgmt",
        "subscribe",
        "redeem"
      ],
      "additionalProperties": false
    },
    "rank_pct_1y": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "max_drawdown_1y": {
      "type": "number"
    },
    "volatility_1y": {
      "type": "number"
    },
    "manager_tenure_years": {
      "type": "number"
    },
    "active_from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "purchase_limit": {
      "type": [
        "number",
        "null"
      ]
    }
  },
  "required": [
    "code",
    "name",
    "org",
    "type",
    "r_level",
    "family",
    "qdii",
    "aum_yi",
    "inception_years",
    "fee",
    "rank_pct_1y",
    "max_drawdown_1y",
    "volatility_1y",
    "manager_tenure_years",
    "active_from",
    "purchase_limit"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^_": {}
  }
}
